<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="CPRTouchVision.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CPRTouchVision.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ex="using:WinUIEx"
    xmlns:sk="using:SkiaSharp.Views.Windows"
    mc:Ignorable="d"
    Width="800"
    MinWidth="800"
    Height="600"
    MinHeight="600"
    Title="CPR Touch Vision">

    <Grid x:Name="Root"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Loaded="OnMainWindowLoaded">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="250" MaxWidth="400" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <ScrollView>
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Stretch"
                        BorderBrush="#EFEFEF"
                        BorderThickness="0 0 1 0"
                        Padding="20">

                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            Margin="0 0 0 20">
                <Image Source="{ThemeResource CprTouchVisionLogo}"
                       Width="40"
                       Height="40" />
                <TextBlock Text="CPR Touch Vision"
                           VerticalAlignment="Center"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
            </StackPanel>

                <!-- Hardware Diagnostics -->
                <TextBlock Text="Hardware Status" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0 0 0 10"/>
                <ItemsControl ItemsSource="{x:Bind _manager.HardwareItems, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:HardwareStatusItem">
                            <StackPanel Orientation="Horizontal" Margin="0 4 0 0">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" Width="120"/>
                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Hardware Ready Banner -->
                <Border Background="{ThemeResource SystemFillColorSuccessBrush}" 
                        Padding="8" 
                        CornerRadius="4" 
                        Margin="0 10 0 0" 
                        Visibility="{x:Bind BoolToVis(_manager.IsHardwareReady), Mode=OneWay}">
                    <TextBlock Text="Hardware Ready" Foreground="White" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                </Border>

                <!-- Hardware Retry Buttton -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0 10 0 0">
                    <Button Content="Retry Connection" 
                        Command="{x:Bind _manager.RunAllHardwareChecksCommand}" 
                        HorizontalAlignment="Left"/>

                    <!-- Optional: Loading indicator while checking -->
                    <ProgressRing IsActive="{x:Bind _manager.IsDeviceChecking, Mode=OneWay}" 
                  Width="20" Height="20" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Error Notification (Shown when NOT ready) -->
                <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" 
                        Padding="8" 
                        CornerRadius="4" 
                        Margin="0 10 0 0" 
                        Visibility="{x:Bind GetErrorVisibility(_manager.IsHardwareReady, _manager.IsDeviceChecking), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        
                        <TextBlock Text="{x:Bind _manager.HardwareErrorMessage, Mode=OneWay}" 
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" 
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Auto Start Toggle -->
                <ToggleSwitch Header="Auto‑start Calibration" IsOn="{x:Bind _manager.AutoStartCalibration, Mode=TwoWay}" Margin="0 10 0 0"/>
               
                <!-- Start Auto Calibration Button -->
                <Button Content="Start Auto Calibration"
                    Click="OnStartAutoCalibrationClicked"
                    HorizontalAlignment="Stretch"
                    Margin="0 10 0 0"
                    IsEnabled="{x:Bind _manager.CanStartAutoCalibration, Mode=OneWay}" />

                <Button Content="{x:Bind _manager.StartStopCalibration, Mode=OneWay}"
                    Click="OnStartStopClicked"
                    HorizontalAlignment="Stretch" 
                    Margin="0 10 0 0"    />

                <ToggleSwitch Header="Auto‑Start Auto Calibration"
                    IsOn="{x:Bind _manager.AutoStartCalibration, Mode=TwoWay}"
                    Margin="0 10 0 0"
                    IsEnabled="{x:Bind _manager.IsAutoMode, Mode=OneWay}" />
                
                <ToggleSwitch
                    Header="Calibration Mode"
                    OnContent="Auto"
                    OffContent="Manual"
                    IsOn="{x:Bind _manager.IsAutoMode, Mode=TwoWay}"
                    Toggled="OnCalibrationModeToggled"
                    Margin="0 20 0 0"/>                
                
                <!-- Touch Zone Section -->
                <Grid Margin="0 20 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Touch Zone"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind _manager.TouchZoneStatus, Mode=OneWay}"
                       Foreground="{x:Bind _manager.TouchZoneForeground, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Grid.Column="1"/>
                </Grid>

                <TextBlock Text="Select 4 points to define a rectangle area for interactions."
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Margin="0 0 0 0" />

                <Button Content="Define"
                Click="OnDefineTouchZoneClicked"
                HorizontalAlignment="Stretch"
                IsEnabled="{x:Bind _manager.IsTouchZoneToggleEnabled, Mode=OneWay}"
                Margin="0 10 0 0" />
                <!-- End of Touch Zone Section -->

                <!-- Touch Offset Section with Min/Max -->
                <TextBlock Text="Touch Offset Range (cm)"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           Margin="0 30 0 0"/>
                <TextBlock Text="Distance from wall to be considered a touch (minimum and maximum)."
                           Style="{ThemeResource CaptionTextBlockStyle}" />

                <StackPanel Orientation="Horizontal"
                            Margin="0 10 0 0"
                            Spacing="10">
                    <NumberBox Header="Min"
                               Value="{x:Bind _manager.MinOffset, Mode=TwoWay}"
                               Minimum="0"
                               Maximum="100"
                               Width="100"/>
                    <NumberBox Header="Max"
                               Value="{x:Bind _manager.MaxOffset, Mode=TwoWay}"
                               Minimum="0"
                               Maximum="100"
                               Width="100"/>
                </StackPanel>

            </StackPanel>
        </ScrollView>

        <!-- Canvas View -->
        <Grid Grid.Column="1"
              Padding="20 40 20 20">
            <StackPanel Orientation="Vertical">
                <Border BorderBrush="#EFEFEF"
                        BorderThickness="1"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch">
                    <Viewbox Stretch="Uniform">
                        <sk:SKXamlCanvas x:Name="Canvas"
                                     Width="1280"
                                     Height="720"
                                     PaintSurface="OnCanvasPaintSurface"
                                     PointerMoved="OnCanvasPointerMoved"
                                     PointerPressed="OnCanvasPointerPressed"/>
                    </Viewbox>
                </Border>
                <TextBlock Text="{x:Bind _manager.CursorLabel, Mode=TwoWay}" 
                       FontSize="10"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</ex:WindowEx>
