<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="CPRTouchVision.Windows.InitWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ex="using:WinUIEx"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CPRTouchVision.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsResizable="False"
    Width="400"
    Height="250"
    Title="CPR Touch Vision Initialization"
    mc:Ignorable="d">

    <ScrollView Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      Padding="10 10 10 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Vertical"
                VerticalAlignment="Center"
                Grid.Row="0">
                <Image Source="{ThemeResource CprTouchVisionLogo}"
               Width="100"
               Height="100"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />
                <ProgressRing IsActive="{x:Bind Model.IsLoading, Mode=OneWay}" 
                      Margin="0 10 0 0"
                      Visibility="{x:Bind Model.LoaderVisibility, Mode=OneWay}" />

                <StackPanel Orientation="Vertical"
                    Margin="0 10 0 0"
                    Visibility="{x:Bind Model.ErrorVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Model.ErrorMessage, Mode=OneWay}"
                       TextAlignment="Center"
                       TextWrapping="WrapWholeWords"
                       MaxLines="100"
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondary}"/>
                    <Button Content="{x:Bind Model.ErrorActionTitle, Mode=OneWay }"
                    Click="OnErrorActionClicked"
                    HorizontalAlignment="Center"
                    Margin="0 10 0 0" />
                </StackPanel>

            </StackPanel>
            <StackPanel Orientation="Vertical"
                HorizontalAlignment="Center"
                Grid.Row="1">
                <TextBlock Text="{x:Bind Model.Copyright}"
                   FontSize="8"
                   Foreground="{ThemeResource TextFillColorTertiary}"
                   TextAlignment="Center"
                   MaxLines="2"
                   Margin="0 8"/>
            </StackPanel>
        </Grid>
    </ScrollView>
</ex:WindowEx>
