                </StackPanel>
            </StackPanel>
        </ScrollView>

        <Grid Grid.Column="1"
          Padding="20">
            <StackPanel Orientation="Vertical">
                <Border BorderBrush="#EFEFEF"
                    BorderThickness="1"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left">
                    <Viewbox Stretch="Uniform">
                        <sk:SKXamlCanvas x:Name="Canvas"
                                     Width="1280"
                                     Height="720"
                                     PaintSurface="OnCanvasPaintSurface"
                                     PointerMoved="OnCanvasPointerMoved"
                                     PointerPressed="OnCanvasPointerPressed"/>
                    </Viewbox>
                </Border>
                <TextBlock Text="{x:Bind _manager.CursorLabel, Mode=TwoWay}" 
                       FontSize="10"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</ex:WindowEx>
