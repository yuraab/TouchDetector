<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="CPRTouchVision.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CPRTouchVision"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ex="using:WinUIEx"
    xmlns:sk="using:SkiaSharp.Views.Windows"
    mc:Ignorable="d"
    Width="800"
    Height="600"
    Title="CPR Touch Vision">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollView>
            <StackPanel Orientation="Vertical"
                BorderBrush="#EFEFEF"
                BorderThickness="0 0 1 0"
                Padding="20">

                <Button Content="{x:Bind _manager.ToggleTitle, Mode=OneWay}"
                Click="OnToggleClicked"
                HorizontalAlignment="Stretch" />

                <!-- Touch Zone Section -->
                <Grid Margin="0 20 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Touch Zone"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind _manager.TouchZoneStatus, Mode=OneWay}"
                       Foreground="{x:Bind _manager.TouchZoneForeground, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Grid.Column="1"/>
                </Grid>

                <TextBlock Text="Select 4 points to define a rectangle area for interactions."
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Margin="0 0 0 0" />

                <Button Content="Define"
                Click="OnDefineTouchZoneClicked"
                HorizontalAlignment="Stretch"
                IsEnabled="{x:Bind _manager.IsTouchZoneToggleEnabled, Mode=OneWay}"
                Margin="0 10 0 0" />
                <!-- End of Touch Zone Section -->

                <!-- Touch Offset Section with Min/Max -->
                <TextBlock Text="Touch Offset Range (cm)"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           Margin="0 30 0 0"/>
                <TextBlock Text="Distance from wall to be considered a touch (minimum and maximum)."
                           Style="{ThemeResource CaptionTextBlockStyle}" />

                <StackPanel Orientation="Horizontal"
                            Margin="0 10 0 0"
                            Spacing="10">
                    <NumberBox Header="Min"
                               Value="{x:Bind _manager.MinOffset, Mode=TwoWay}"
                               Minimum="0"
                               Maximum="100"
                               Width="100"/>
                    <NumberBox Header="Max"
                               Value="{x:Bind _manager.MaxOffset, Mode=TwoWay}"
                               Minimum="0"
                               Maximum="100"
                               Width="100"/>
                </StackPanel>

            </StackPanel>
        </ScrollView>

        <!-- Canvas View -->
        <Grid Grid.Column="1"
          Padding="20">
            <StackPanel Orientation="Vertical">
                <Border BorderBrush="#EFEFEF"
                    BorderThickness="1"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left">
                    <Viewbox Stretch="Uniform">
                        <sk:SKXamlCanvas x:Name="Canvas"
                                     Width="1280"
                                     Height="720"
                                     PaintSurface="OnCanvasPaintSurface"
                                     PointerMoved="OnCanvasPointerMoved"
                                     PointerPressed="OnCanvasPointerPressed"/>
                    </Viewbox>
                </Border>
                <TextBlock Text="{x:Bind _manager.CursorLabel, Mode=TwoWay}" 
                       FontSize="10"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</ex:WindowEx>
