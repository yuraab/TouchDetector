<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="CPRTouchVision.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CPRTouchVision"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ex="using:WinUIEx"
    xmlns:sk="using:SkiaSharp.Views.Windows"
    mc:Ignorable="d"
    Width="800"
    Height="500"
    Title="CPR Touch Vision">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollView>
            <StackPanel Orientation="Vertical"
                BorderBrush="#EFEFEF"
                BorderThickness="0 0 1 0"
                Padding="20">
                <Button Content="{x:Bind _manager.ToggleTitle, Mode=OneWay}"
                Click="OnToggleClicked"
                HorizontalAlignment="Stretch" />

                <Grid Margin="0 20 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Floor Level"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind _manager.FloorLevelStatus, Mode=OneWay}"
                       Foreground="{x:Bind _manager.FloorLevelForeground, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Grid.Column="1"/>
                </Grid>
                <TextBlock Text="Select 3 points on the floor to define zero-level plane."
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Margin="0 0 0 0" />
                <Button Content="Define"
                Click="OnDefineFloorClicked"
                HorizontalAlignment="Stretch"
                IsEnabled="{x:Bind _manager.IsCalibrationToggleEnabled, Mode=OneWay}"
                Margin="0 10 0 0" />

                <TextBlock Text="Jump Offset"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       Margin="0 20 0 0 " />
                <TextBlock Text="The distance (cm) from floor level to be considered a jump."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Margin="0 0 0 0" />
                <NumberBox Value="{x:Bind _manager.Offset, Mode=TwoWay}"
                       Minimum="0"
                       Maximum="100"
                       SmallChange="1"
                       LargeChange="10"
                       Margin="0 10 0 0"/>

                <StackPanel Orientation="Vertical"
                    Margin="0 20 0 0">
                    <TextBlock Text="Trampolines"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Stretch"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <Button Content="Add"
                        HorizontalAlignment="Stretch"
                        Click="OnAddTrampolineClicked"
                        Margin="0 10 0 0"
                        IsEnabled="{x:Bind _manager.CanAddTrampolines, Mode=OneWay}"/>

                    <!--ItemsRepeater x:Name="Repeater"
                           ItemsSource="{x:Bind _manager.Trampolines, Mode=OneWay}">
