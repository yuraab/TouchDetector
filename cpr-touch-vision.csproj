<Project Sdk="Microsoft.NET.Sdk">

	<!-- ========================= -->
	<!--   COMMON PROPERTIES       -->
	<!-- ========================= -->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>CPRTouchVision</RootNamespace>
		<UseWinUI>true</UseWinUI>
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
		<WindowsSdkPackageVersion>10.0.19041.38</WindowsSdkPackageVersion>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<Configurations>Debug;Release;Test;Mock</Configurations>
		<SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
		<PublishReadyToRun>False</PublishReadyToRun>
		<PublishTrimmed>False</PublishTrimmed>

		<DisableWinUIAppXamlGeneratedMain>false</DisableWinUIAppXamlGeneratedMain>
		
	</PropertyGroup>
		
	
	<!-- ========================= -->
	<!--   PACKAGED (Debug/Release) -->
	<!-- ========================= -->
	<PropertyGroup Condition="'$(Configuration)'!='Test'">
		<EnableMsixTooling>true</EnableMsixTooling>
		<WindowsPackageType>MSIX</WindowsPackageType>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
		<PackageCertificateThumbprint>526B61533B2E1881D0EB9F7219DDF29C7D05F3B8</PackageCertificateThumbprint>
		<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
		<GenerateAppInstallerFile>True</GenerateAppInstallerFile>
		<AppInstallerUri>https://cpr.software/downloads/cpr-touch-vision</AppInstallerUri>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
		<GenerateTestArtifacts>True</GenerateTestArtifacts>
		<AppxBundle>Never</AppxBundle>
		<HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
	</PropertyGroup>

	<!-- ========================= -->
	<!--   UNPACKAGED (Test)        -->
	<!-- ========================= -->
	<PropertyGroup Condition="'$(Configuration)'=='Test'">
		<DisableWinUIAppXamlGeneratedMain>true</DisableWinUIAppXamlGeneratedMain>
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<StartupObject>CPRTouchVision.Startup</StartupObject>
		<EnableMsixTooling>false</EnableMsixTooling>
		<WindowsPackageType>None</WindowsPackageType>
		<AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
		<UseMrtCore>false</UseMrtCore>
		<UsePackageManifest>false</UsePackageManifest>
		<GeneratePriEnabled>false</GeneratePriEnabled>
		<WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
		<DisableWinUIAppXamlGeneratedMain>true</DisableWinUIAppXamlGeneratedMain>
		<!-- <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained> -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<PublishSingleFile>false</PublishSingleFile>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Mock'">
	  <DisableWinUIAppXamlGeneratedMain>true</DisableWinUIAppXamlGeneratedMain>
	  <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
	  <StartupObject>CPRTouchVision.Startup</StartupObject>
	  <EnableMsixTooling>false</EnableMsixTooling>
	  <WindowsPackageType>None</WindowsPackageType>
	  <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
	  <UseMrtCore>false</UseMrtCore>
	  <UsePackageManifest>false</UsePackageManifest>
	  <GeneratePriEnabled>false</GeneratePriEnabled>
	  <WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
	  <DisableWinUIAppXamlGeneratedMain>true</DisableWinUIAppXamlGeneratedMain>
	  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
	  <SelfContained>false</SelfContained>
	  <PublishSingleFile>false</PublishSingleFile>
	</PropertyGroup>

	<!-- ========================= -->
	<!--   RELEASE SYMBOLS         -->
	<!-- ========================= -->
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<!-- ========================= -->
	<!--   ASSETS                  -->
	<!-- ========================= -->
	<ItemGroup>
		<Content Include="Assets\favicon.ico" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Assets\imgs\**\*.*" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Assets\svg\**\*.*" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Assets\SplashScreen.scale-200.png" />
		<Content Include="Assets\LockScreenLogo.scale-200.png" />
		<Content Include="Assets\Square150x150Logo.scale-200.png" />
		<Content Include="Assets\Square44x44Logo.scale-200.png" />
		<Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
		<Content Include="Assets\Wide310x150Logo.scale-200.png" />
	</ItemGroup>

	<!-- ========================= -->
	<!--   PACKAGED ONLY FILES     -->
	<!-- ========================= -->
	<ItemGroup Condition="'$(Configuration)'!='Test'">
		<Manifest Include="app.manifest" />
		<AppxManifest Include="Package.appxmanifest" />
	</ItemGroup>

	<!-- MSIX capability only for packaged -->
	<ItemGroup Condition="'$(Configuration)'!='Test' and '$(DisableMsixProjectCapabilityAddedByProject)'!='true'">
		<ProjectCapability Include="Msix" />
	</ItemGroup>

	<!-- ========================= -->
	<!--   TEST ONLY EXCLUSIONS    -->
	<!-- ========================= -->
	<ItemGroup>
		<Compile Remove="AppWindows\InitWindow.xaml.cs" Condition="'$(Configuration)'=='Test'" />
		<Compile Condition="'$(Configuration)'=='Mock'" Remove="AppWindows\InitWindow.xaml.cs" />
		<Page Remove="AppWindows\InitWindow.xaml" Condition="'$(Configuration)'=='Test'" />
		<Page Condition="'$(Configuration)'=='Mock'" Remove="AppWindows\InitWindow.xaml" />
		
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='Test'">
		<None Include="$(NuGetPackageRoot)microsoft.windowsappsdk\1.6.240829000\tools\**\*.*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='Mock'">
	  <None Include="$(NuGetPackageRoot)microsoft.windowsappsdk\1.6.240829000\tools\**\*.*">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
	
	<!-- ========================= -->
	<!--   NATIVE DLLS             -->
	<!-- ========================= -->
	<!-- Test: copy flat to output -->
	<ItemGroup Condition="'$(Configuration)'=='Test'">
		<Content Include="C:\ProgramData\CPR Soft\bin\*.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="C:\ProgramData\CPR Soft\bin\*.onnx">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)'=='Mock'">
	  <Content Include="C:\ProgramData\CPR Soft\bin\*.dll">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	  <Content Include="C:\ProgramData\CPR Soft\bin\*.onnx">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<!-- Packaged: copy with PackagePath -->
	<ItemGroup Condition="'$(Configuration)'!='Test'">
		<Content Include="C:\ProgramData\CPR Soft\bin\*.dll">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<PackagePath>runtimes\win-x64\native</PackagePath>
		</Content>
		<Content Include="C:\ProgramData\CPR Soft\bin\*.onnx">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<PackagePath>runtimes\win-x64\native</PackagePath>
		</Content>
	</ItemGroup>

	<!-- ========================= -->
	<!--   NUGET PACKAGES          -->
	<!-- ========================= -->
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="ComputeSharp" Version="3.2.0" />
		<PackageReference Include="DBSCAN.RBush" Version="3.0.0" />
		<PackageReference Include="DBSCAN" Version="3.0.0" />
		<PackageReference Include="Emgu.CV" Version="4.11.0.5746" />
		<PackageReference Include="Emgu.CV.runtime.windows" Version="4.11.0.5746" />
		<PackageReference Include="Microsoft.PowerShell.SDK" Version="7.5.2" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="OpenCvSharp4" Version="4.13.0.20260302" />
		<PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20260302" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260302" />
		<PackageReference Include="SkiaSharp.Views.WinUI" Version="3.119.0" />
		<PackageReference Include="System.Management" Version="9.0.7" />
		<PackageReference Include="Vizcon.OSC" Version="1.0.3" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240829000" />
		<PackageReference Include="WinUIEx" Version="2.5.0" />
		<PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
	</ItemGroup>

	<!-- ========================= -->
	<!--   PROJECT REFERENCES      -->
	<!-- ========================= -->
	<ItemGroup Condition="'$(Configuration)'!='Test'">
		<ProjectReference Include="..\cpr-lib-old\CPRLib.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\cpr-projector-shared\CPRProjectorShared.csproj" />
		<ProjectReference Include="..\ob-sharp\ob-sharp.csproj" />
	</ItemGroup>

	<!-- ========================= -->
	<!--   SHARPOSC                -->
	<!-- ========================= -->
	<ItemGroup>
		<Reference Include="SharpOSC">
			<HintPath>..\..\..\..\..\dev\SharpOSC.dll</HintPath>
		</Reference>
	</ItemGroup>

	<!-- ========================= -->
	<!--   COPY PROJECTOR OUTPUT   -->
	<!-- ========================= -->
	<ItemGroup>
		<None Include="..\cpr-projector\bin\x64\Release\net9.0-windows\**\*.*" Exclude="**\System.Management.dll;**\System.CodeDom.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- ========================= -->
	<!--   COPY NATIVE DEPS        -->
	<!-- ========================= -->
	<Target Name="CopyNativeDependencies" AfterTargets="Build">
		<ItemGroup>
			<NativeDlls Include="..\ob-sharp\bin\$(Configuration)\netstandard2.1\*.dll" />
			<OnnxFiles Include="..\ob-sharp\bin\$(Configuration)\netstandard2.1\*.onnx" />
		</ItemGroup>
		<Copy SourceFiles="@(NativeDlls)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(OnnxFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
	</Target>

	<!-- Dotnet Reactor (optional) -->
	<Import Project="cpr-touch-vision.dotnet_reactor.targets" Condition="Exists('cpr-touch-vision.dotnet_reactor.targets')" />

</Project>